@model FastFood.Models.Category
@{
    ViewData["Title"] = "Chi Tiết Danh Mục: " + Model.CategoryName;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold text-dark mb-1">Chi Tiết Danh Mục: <span class="text-danger">@Model.CategoryName</span></h4>
        <p class="text-muted small mb-0">Xem thông tin và toàn bộ danh sách sản phẩm thuộc nhóm này</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.CategoryId" class="btn btn-warning fw-semibold">
            <i class="fa fa-edit me-1"></i> Chỉnh Sửa
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="fa fa-arrow-left me-1"></i> Quay Lại
        </a>
    </div>
</div>

<div class="card card-custom mb-4">
    <div class="card-body p-4">
        <div class="row align-items-center">
            <div class="col-md-2 text-center mb-3 mb-md-0">
                <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "https://images.unsplash.com/photo-1568901346375-23c9450c58cd?w=200&q=80" : Model.ImageUrl)" 
                     class="img-fluid rounded-4 shadow-sm" style="max-height: 120px; object-fit: cover;" alt="" />
            </div>
            <div class="col-md-10">
                <h4 class="fw-bold text-dark mb-2">@Model.CategoryName</h4>
                <p class="text-muted mb-2">@(Model.Description ?? "Không có mô tả chi tiết.")</p>
                <div class="d-flex gap-3">
                    <span class="badge bg-primary fs-6"><i class="fa fa-boxes me-1"></i> Tổng số: <strong>@Model.Products.Count</strong> sản phẩm</span>
                    <span class="badge bg-light text-dark border fs-6">Thứ tự hiển thị: @Model.DisplayOrder</span>
                    @if (Model.Status)
                    {
                        <span class="badge bg-success fs-6">Đang kinh doanh</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary fs-6">Tạm ẩn</span>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card card-custom">
    <div class="card-header-custom">
        <h5 class="fw-bold"><i class="fa fa-hamburger text-danger me-2"></i>Danh Sách Sản Phẩm Thuộc Danh Mục "@Model.CategoryName"</h5>
        <a asp-area="Admin" asp-controller="Product" asp-action="Create" class="btn btn-sm btn-danger">
            <i class="fa fa-plus-circle me-1"></i> Thêm món vào danh mục này
        </a>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-custom table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width: 70px;">Ảnh</th>
                        <th>Tên món</th>
                        <th class="text-end">Đơn giá</th>
                        <th class="text-center">Số lượng tồn</th>
                        <th class="text-center">Đã bán</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Products != null && Model.Products.Any())
                    {
                        foreach (var prod in Model.Products)
                        {
                            <tr>
                                <td>
                                    <img src="@(string.IsNullOrEmpty(prod.ImageUrl) ? "https://images.unsplash.com/photo-1568901346375-23c9450c58cd?w=100&q=80" : prod.ImageUrl)" 
                                         width="45" height="45" class="rounded-3 shadow-sm object-fit-cover" alt="" />
                                </td>
                                <td>
                                    <strong class="text-dark">@prod.ProductName</strong>
                                </td>
                                <td class="text-end fw-bold text-danger">@prod.Price.ToString("N0") đ</td>
                                <td class="text-center">
                                    <span class="badge @(prod.Quantity > 0 ? "bg-success" : "bg-danger")">@prod.Quantity</span>
                                </td>
                                <td class="text-center fw-semibold text-muted">@prod.SoldQuantity</td>
                                <td class="text-end">
                                    <a asp-area="Admin" asp-controller="Product" asp-action="Details" asp-route-id="@prod.ProductId" class="btn btn-sm btn-outline-info">
                                        <i class="fa fa-eye"></i>
                                    </a>
                                    <a asp-area="Admin" asp-controller="Product" asp-action="Edit" asp-route-id="@prod.ProductId" class="btn btn-sm btn-outline-warning">
                                        <i class="fa fa-edit"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">
                                <i class="fa fa-folder-open fa-2x mb-2 d-block text-secondary"></i>
                                Danh mục này hiện chưa có món ăn nào.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
