@model FastFood.Models.Product
@{
    ViewData["Title"] = "Chỉnh Sửa Món Ăn";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold text-dark mb-1">Chỉnh Sửa Món Ăn: <span class="text-danger">@Model.ProductName</span></h4>
        <p class="text-muted small mb-0">Cập nhật thông tin, giá bán và số lượng tồn kho</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="fa fa-arrow-left me-1"></i> Quay Lại
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="card card-custom">
            <div class="card-body p-4 p-md-5">
                <form asp-action="Edit" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    <input type="hidden" asp-for="ProductId" />
                    <input type="hidden" asp-for="ImageUrl" />
                    
                    <div class="row g-3 mb-3">
                        <div class="col-md-8">
                            <label asp-for="ProductName" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                            <input asp-for="ProductName" class="form-control" />
                            <span asp-validation-for="ProductName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="CategoryId" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                            <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryId"></select>
                            <span asp-validation-for="CategoryId" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label asp-for="Price" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                            <div class="input-group">
                                <input asp-for="Price" class="form-control" type="number" min="1000" step="1" value="@Model.Price.ToString("0", System.Globalization.CultureInfo.InvariantCulture)" />
                                <span class="input-group-text">VNĐ</span>
                            </div>
                            <span asp-validation-for="Price" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Quantity" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                            <input asp-for="Quantity" class="form-control" type="number" min="0" />
                            <span asp-validation-for="Quantity" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="SoldQuantity" class="form-label fw-semibold"></label>
                            <input asp-for="SoldQuantity" class="form-control" type="number" min="0" />
                            <span asp-validation-for="SoldQuantity" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold"></label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <!-- THAY ĐỔI ẢNH / UPLOAD ẢNH MỚI -->
                    <div class="row g-3 mb-4 p-3 bg-light rounded-3 border align-items-center">
                        <div class="col-md-3 text-center">
                            <label class="form-label small text-muted d-block">Ảnh hiện tại:</label>
                            <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "https://images.unsplash.com/photo-1568901346375-23c9450c58cd?w=100&q=80" : Model.ImageUrl)" 
                                 width="80" height="80" class="rounded-3 shadow-sm object-fit-cover" alt="" />
                        </div>
                        <div class="col-md-9">
                            <label class="form-label fw-bold text-dark"><i class="fa fa-upload text-danger me-1"></i> Tải Lên Ảnh Mới Thay Thế</label>
                            <input type="file" name="uploadImage" class="form-control" accept="image/*" />
                            <small class="text-muted">Chọn ảnh mới nếu muốn thay đổi ảnh hiện tại</small>
                        </div>
                    </div>

                    <div class="mb-4">
                        <div class="form-check form-switch fs-5">
                            <input class="form-check-input" type="checkbox" role="switch" asp-for="Status" />
                            <label class="form-check-label fs-6 fw-semibold" asp-for="Status">Đang mở bán trên thực đơn</label>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 border-top pt-4">
                        <a asp-action="Index" class="btn btn-light px-4">Hủy Bỏ</a>
                        <button type="submit" class="btn btn-warning px-4 fw-bold">
                            <i class="fa fa-save me-1"></i> Cập Nhật Món Ăn
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
