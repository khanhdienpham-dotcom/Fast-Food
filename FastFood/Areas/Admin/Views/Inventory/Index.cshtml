@model FastFood.Models.ViewModels.InventoryViewModel
@{
    ViewData["Title"] = "Quản Lý Kho Hàng";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold text-dark mb-1">Quản Lý Kho Hàng</h4>
        <p class="text-muted small mb-0">Theo dõi số lượng hàng tồn kho và danh sách các món ăn cần nhập hàng</p>
    </div>
    <div class="d-flex gap-2">
        <span class="badge bg-success-subtle text-success border border-success px-3 py-2 fs-6">
            <i class="fa fa-boxes me-1"></i> Hàng tồn: <strong>@Model.InStockProducts.Count</strong> món
        </span>
        <span class="badge bg-danger-subtle text-danger border border-danger px-3 py-2 fs-6">
            <i class="fa fa-exclamation-circle me-1"></i> Cần nhập: <strong>@Model.OutOfStockProducts.Count</strong> món
        </span>
    </div>
</div>

<ul class="nav nav-pills mb-4" id="inventoryTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active fw-bold px-4 py-2 me-2" id="in-stock-tab" data-bs-toggle="pill" data-bs-target="#in-stock-panel" type="button" role="tab">
            <i class="fa fa-warehouse me-2 text-success"></i> 1. Danh Sách Hàng Tồn (Số Lượng > 0)
            <span class="badge bg-success ms-2">@Model.InStockProducts.Count</span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link fw-bold px-4 py-2" id="out-of-stock-tab" data-bs-toggle="pill" data-bs-target="#out-of-stock-panel" type="button" role="tab">
            <i class="fa fa-exclamation-triangle me-2 text-danger"></i> 2. Danh Sách Hàng Cần Nhập (Số Lượng = 0)
            <span class="badge bg-danger ms-2">@Model.OutOfStockProducts.Count</span>
        </button>
    </li>
</ul>

<div class="tab-content" id="inventoryTabsContent">
    <div class="tab-pane fade show active" id="in-stock-panel" role="tabpanel">
        <div class="card card-custom">
            <div class="card-header-custom bg-white">
                <h5 class="fw-bold text-success"><i class="fa fa-check-circle me-2"></i>Các Món Ăn Còn Tồn Kho (Đang Bán Được)</h5>
            </div>
            <div class="card-body p-0">
                @await Html.PartialAsync("_InventoryListPartial", Model.InStockProducts)
            </div>
        </div>
    </div>

    <div class="tab-pane fade" id="out-of-stock-panel" role="tabpanel">
        <div class="card card-custom border-danger">
            <div class="card-header-custom bg-danger-subtle">
                <h5 class="fw-bold text-danger"><i class="fa fa-bell me-2"></i>Các Món Ăn Hết Hàng (Cần Bổ Sung Tồn Kho Ngay)</h5>
            </div>
            <div class="card-body p-0">
                @await Html.PartialAsync("_InventoryListPartial", Model.OutOfStockProducts)
            </div>
        </div>
    </div>
</div>
