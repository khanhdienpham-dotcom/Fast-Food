@model FastFood.Models.User
@{
    ViewData["Title"] = "Chỉnh Sửa Quản Trị Viên";
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold text-dark mb-1">Chỉnh Sửa Quản Trị Viên: <span class="text-danger">@Model.Username</span></h4>
        <p class="text-muted small mb-0">Cập nhật thông tin tài khoản người quản trị</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="fa fa-arrow-left me-1"></i> Quay Lại</a>
</div>
<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card card-custom">
            <div class="card-body p-4 p-md-5">
                <form asp-action="Edit" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    <input type="hidden" asp-for="UserId" />
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                            <input asp-for="FullName" class="form-control" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Username" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                            <input asp-for="Username" class="form-control" readonly />
                            <span asp-validation-for="Username" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                            <input asp-for="Email" class="form-control" type="email" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                            <input asp-for="Phone" class="form-control" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="Password">Mật khẩu mới <small class="text-muted fw-normal">(để trống nếu giữ nguyên mật khẩu cũ)</small></label>
                        <input id="Password" name="Password" class="form-control" type="password" autocomplete="new-password"
                               data-val="true" data-val-length="Mật khẩu phải từ 4 đến 100 ký tự" data-val-length-min="4" data-val-length-max="100" maxlength="100" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Address" class="form-label fw-semibold"></label>
                        <input asp-for="Address" class="form-control" />
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>
                    <div class="mb-4">
                        <div class="form-check form-switch fs-5">
                            <input class="form-check-input" type="checkbox" role="switch" asp-for="Status" />
                            <label class="form-check-label fs-6 fw-semibold" asp-for="Status">Kích hoạt tài khoản</label>
                        </div>
                        <span asp-validation-for="Status" class="text-danger small"></span>
                    </div>
                    <div class="d-flex justify-content-end gap-2 border-top pt-4">
                        <a asp-action="Index" class="btn btn-light px-4">Hủy Bỏ</a>
                        <button type="submit" class="btn btn-warning px-4 fw-bold"><i class="fa fa-save me-1"></i> Cập Nhật</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
