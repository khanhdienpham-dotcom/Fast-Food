@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    var username = HttpContextAccessor.HttpContext?.Session.GetString("Username") ?? "Admin";
    var fullName = HttpContextAccessor.HttpContext?.Session.GetString("FullName") ?? "Quản trị viên";

    // Đánh dấu menu đang mở theo controller / action hiện tại
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    string Active(string c, string? a = null) =>
        controller == c && (a == null || action == a) ? "active" : "";
    string MenuOpen(string c) => controller == c ? "menu-open" : "";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản Trị FastFood</title>

    <!-- Template quản trị: AdminLTE 4 (https://adminlte.io) - đã bao gồm Bootstrap 5.3 -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@300;400;600;700&display=swap" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="~/lib/admin-lte/css/adminlte.min.css" />

    <!-- Màu sắc / tương phản riêng cho khu Admin, ghi đè lên AdminLTE -->
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="layout-fixed sidebar-expand-lg bg-body-tertiary">
    <div class="app-wrapper">

        <!-- ===== HEADER ===== -->
        <nav class="app-header navbar navbar-expand bg-body">
            <div class="container-fluid">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link" data-lte-toggle="sidebar" href="#" role="button" title="Thu gọn / mở rộng menu">
                            <i class="fa fa-bars"></i>
                        </a>
                    </li>
                    <li class="nav-item d-none d-md-block">
                        <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="nav-link">Trang quản trị</a>
                    </li>
                    <li class="nav-item d-none d-md-block">
                        <a asp-area="" asp-controller="Home" asp-action="Index" target="_blank" class="nav-link">Xem website</a>
                    </li>
                </ul>

                <ul class="navbar-nav ms-auto">
                    <li class="nav-item dropdown user-menu">
                        <a href="#" class="nav-link dropdown-toggle" data-bs-toggle="dropdown">
                            <i class="fa fa-user-circle fa-lg text-primary me-1"></i>
                            <span class="d-none d-md-inline">@fullName</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-lg dropdown-menu-end">
                            <li class="user-header text-bg-primary">
                                <i class="fa fa-user-shield fa-3x my-2"></i>
                                <p>
                                    @fullName
                                    <small>@username - Quản trị viên</small>
                                </p>
                            </li>
                            <li class="user-footer">
                                <a asp-area="" asp-controller="Account" asp-action="Profile" class="btn btn-default btn-flat">Hồ sơ</a>
                                <a asp-area="" asp-controller="Account" asp-action="Logout" class="btn btn-default btn-flat float-end">Đăng xuất</a>
                            </li>
                        </ul>
                    </li>
                </ul>
            </div>
        </nav>

        <!-- ===== SIDEBAR ===== -->
        <aside class="app-sidebar bg-body-secondary shadow" data-bs-theme="dark">
            <div class="sidebar-brand">
                <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="brand-link">
                    <img src="https://img.icons8.com/color/48/000000/hamburger.png" alt="FastFood" class="brand-image brand-image-fastfood opacity-75 shadow" />
                    <span class="brand-text fw-light">FastFood Admin</span>
                </a>
            </div>

            <div class="sidebar-wrapper">
                <nav class="mt-2">
                    <ul class="nav sidebar-menu flex-column" data-lte-toggle="treeview" role="navigation" data-accordion="false">
                        <li class="nav-item">
                            <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="nav-link @Active("Home")">
                                <i class="nav-icon fa fa-tachometer-alt"></i>
                                <p>Tổng quan Dashboard</p>
                            </a>
                        </li>

                        <li class="nav-header">DANH MỤC &amp; HÀNG HÓA</li>
                        <li class="nav-item @MenuOpen("Category")">
                            <a href="#" class="nav-link @Active("Category")">
                                <i class="nav-icon fa fa-folder"></i>
                                <p>
                                    Quản lý danh mục
                                    <i class="nav-arrow fa fa-chevron-right"></i>
                                </p>
                            </a>
                            <ul class="nav nav-treeview">
                                <li class="nav-item">
                                    <a asp-area="Admin" asp-controller="Category" asp-action="Index" class="nav-link @Active("Category", "Index")">
                                        <i class="nav-icon fa fa-list"></i>
                                        <p>Danh sách danh mục</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-area="Admin" asp-controller="Category" asp-action="Create" class="nav-link @Active("Category", "Create")">
                                        <i class="nav-icon fa fa-plus-circle"></i>
                                        <p>Thêm danh mục mới</p>
                                    </a>
                                </li>
                            </ul>
                        </li>

                        <li class="nav-item @MenuOpen("Product")">
                            <a href="#" class="nav-link @Active("Product")">
                                <i class="nav-icon fa fa-hamburger"></i>
                                <p>
                                    Quản lý hàng hóa
                                    <i class="nav-arrow fa fa-chevron-right"></i>
                                </p>
                            </a>
                            <ul class="nav nav-treeview">
                                <li class="nav-item">
                                    <a asp-area="Admin" asp-controller="Product" asp-action="Index" class="nav-link @Active("Product", "Index")">
                                        <i class="nav-icon fa fa-boxes"></i>
                                        <p>Danh sách sản phẩm</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-area="Admin" asp-controller="Product" asp-action="Create" class="nav-link @Active("Product", "Create")">
                                        <i class="nav-icon fa fa-plus-circle"></i>
                                        <p>Thêm sản phẩm mới</p>
                                    </a>
                                </li>
                            </ul>
                        </li>

                        <li class="nav-item">
                            <a asp-area="Admin" asp-controller="Inventory" asp-action="Index" class="nav-link @Active("Inventory")">
                                <i class="nav-icon fa fa-warehouse"></i>
                                <p>Quản lý kho hàng</p>
                            </a>
                        </li>

                        <li class="nav-header">TÀI KHOẢN &amp; KHÁCH HÀNG</li>
                        <li class="nav-item">
                            <a asp-area="Admin" asp-controller="User" asp-action="Index" class="nav-link @Active("User")">
                                <i class="nav-icon fa fa-user-shield"></i>
                                <p>Quản lý người dùng (Admin)</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-area="Admin" asp-controller="Customer" asp-action="Index" class="nav-link @Active("Customer")">
                                <i class="nav-icon fa fa-users"></i>
                                <p>Quản lý khách hàng</p>
                            </a>
                        </li>

                        <li class="nav-header">BÁN HÀNG</li>
                        <li class="nav-item">
                            <a asp-area="Admin" asp-controller="Order" asp-action="Index" class="nav-link @Active("Order")">
                                <i class="nav-icon fa fa-receipt"></i>
                                <p>Quản lý đơn hàng</p>
                            </a>
                        </li>

                        <li class="nav-header">HỆ THỐNG</li>
                        <li class="nav-item">
                            <a asp-area="" asp-controller="Home" asp-action="Index" target="_blank" class="nav-link">
                                <i class="nav-icon fa fa-external-link-alt"></i>
                                <p>Xem trang khách hàng</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-area="" asp-controller="Account" asp-action="Logout" class="nav-link">
                                <i class="nav-icon fa fa-sign-out-alt text-danger"></i>
                                <p>Đăng xuất</p>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        </aside>

        <!-- ===== NỘI DUNG CHÍNH ===== -->
        <main class="app-main">
            <div class="app-content-header">
                <div class="container-fluid">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Home" asp-action="Index">Quản trị</a></li>
                        <li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]</li>
                    </ol>
                </div>
            </div>

            <div class="app-content">
                <div class="container-fluid">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="fa fa-check-circle me-2"></i> @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="fa fa-exclamation-triangle me-2"></i> @TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @RenderBody()
                </div>
            </div>
        </main>

        <!-- ===== FOOTER ===== -->
        <footer class="app-footer">
            <div class="float-end d-none d-sm-inline">Template: <a href="https://adminlte.io" target="_blank" class="text-decoration-none">AdminLTE 4</a></div>
            <strong>&copy; @DateTime.Now.Year FastFood Store.</strong> Hệ thống quản trị cửa hàng.
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/admin-lte/plugins/bootstrap/bootstrap.bundle.min.js"></script>
    <script src="~/lib/admin-lte/js/adminlte.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
