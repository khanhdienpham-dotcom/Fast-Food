@{
    int code = ViewBag.Code is int c ? c : 404;
    ViewData["Title"] = code == 404 ? "Không tìm thấy trang" : "Có lỗi xảy ra";
}
<div class="container py-5 text-center">
    <div class="card border-0 shadow-sm rounded-4 p-5 bg-white mx-auto" style="max-width: 600px;">
        <div class="display-1 fw-bold text-danger mb-2">@code</div>
        @if (code == 404)
        {
            <h3 class="fw-bold text-dark">Không tìm thấy trang hoặc món ăn bạn cần!</h3>
            <p class="text-muted mb-4">Đường dẫn có thể đã bị gõ sai, hoặc món ăn này không còn kinh doanh.</p>
        }
        else
        {
            <h3 class="fw-bold text-dark">Yêu cầu không hợp lệ</h3>
            <p class="text-muted mb-4">Vui lòng quay lại trang trước và thử lại.</p>
        }
        <div class="d-flex justify-content-center gap-3">
            <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-danger rounded-pill px-4"><i class="fa fa-home me-1"></i> Về Trang Chủ</a>
            <a asp-area="" asp-controller="Product" asp-action="Index" class="btn btn-outline-danger rounded-pill px-4"><i class="fa fa-utensils me-1"></i> Xem Thực Đơn</a>
        </div>
    </div>
</div>
