@{
    ViewData["Title"] = "Chính Sách Bảo Mật";
}
<div class="container py-5">
    <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
        <h2 class="fw-bold text-dark mb-3"><i class="fa fa-shield-alt text-danger me-2"></i>@ViewData["Title"]</h2>
        <p class="text-muted">FastFood Store chỉ sử dụng thông tin cá nhân (họ tên, số điện thoại, địa chỉ, email) để xử lý và giao đơn hàng cho quý khách.</p>
        <p class="text-muted mb-0">Chúng tôi không chia sẻ thông tin của khách hàng cho bên thứ ba khi chưa có sự đồng ý của khách hàng.</p>
    </div>
</div>
