@model FastFood.Models.User
@{
    Layout = "_MasterLayout";
    ViewData["Title"] = "Hồ Sơ Khách Hàng";
}
<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
                <div class="p-4 bg-dark text-white d-flex align-items-center gap-3">
                    <i class="fa fa-user-circle fa-3x text-warning"></i>
                    <div>
                        <h4 class="fw-bold mb-0">Hồ Sơ Khách Hàng</h4>
                        <small class="text-white-50">Cập nhật thông tin giao hàng cá nhân</small>
                    </div>
                </div>
                <div class="card-body p-4 p-md-5">
                    <form asp-action="Profile" method="post">
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Tên đăng nhập:</label>
                                <input class="form-control" value="@Model.Username" readonly />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Email:</label>
                                <input class="form-control" value="@Model.Email" readonly />
                            </div>
                        </div>
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="FullName" class="form-label fw-semibold"></label>
                                <input asp-for="FullName" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Phone" class="form-label fw-semibold"></label>
                                <input asp-for="Phone" class="form-control" />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Address" class="form-label fw-semibold"></label>
                            <input asp-for="Address" class="form-control" />
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-semibold">Đổi mật khẩu mới (Để trống nếu giữ nguyên):</label>
                            <input name="Password" type="password" class="form-control" placeholder="Mật khẩu mới..." maxlength="100" />
                        </div>
                        <button type="submit" class="btn btn-danger fw-bold rounded-pill px-4">
                            <i class="fa fa-save me-1"></i> Lưu Thay Đổi
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
