@model FastFood.Models.ViewModels.RegisterViewModel
@{
    Layout = "_MasterLayout";
    ViewData["Title"] = "Đăng Ký Tài Khoản";
}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden bg-white">
                <div class="p-4 bg-dark text-white text-center">
                    <img src="https://img.icons8.com/color/48/000000/hamburger.png" width="40" height="40" alt="" />
                    <h4 class="fw-bold text-warning mt-2 mb-0">ĐĂNG KÝ TÀI KHOẢN</h4>
                    <small class="text-white-50">Tạo tài khoản nhận ưu đãi 20% cho đơn hàng đầu tiên</small>
                </div>
                <div class="card-body p-4 p-md-5">
                    <!-- BAREM: ĐÃ KIỂM TRA DỮ LIỆU NHẬP (DATA ANNOTATION), TRÙNG TÀI KHOẢN, THẤT BẠI CÓ THÔNG BÁO -->
                    <form asp-action="Register" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="FullName" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                                <input asp-for="FullName" class="form-control" placeholder="Nguyễn Văn A" />
                                <span asp-validation-for="FullName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Username" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                                <input asp-for="Username" class="form-control" placeholder="nguyenvana" />
                                <span asp-validation-for="Username" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                                <input asp-for="Email" class="form-control" type="email" placeholder="vana@gmail.com" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Phone" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                                <input asp-for="Phone" class="form-control" placeholder="0901234567" />
                                <span asp-validation-for="Phone" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Address" class="form-label fw-semibold"></label>
                            <input asp-for="Address" class="form-control" placeholder="Số nhà, tên đường, quận/huyện..." />
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="Password" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                                <input asp-for="Password" class="form-control" type="password" placeholder="Tối thiểu 4 ký tự" />
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ConfirmPassword" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                                <input asp-for="ConfirmPassword" class="form-control" type="password" placeholder="Nhập lại mật khẩu" />
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-danger btn-lg w-100 fw-bold rounded-pill shadow mb-3">
                            <i class="fa fa-user-plus me-2"></i> ĐĂNG KÝ NGAY
                        </button>

                        <div class="text-center small text-muted">
                            Đã có tài khoản? <a asp-action="Login" class="text-danger fw-bold text-decoration-none">Đăng nhập</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
