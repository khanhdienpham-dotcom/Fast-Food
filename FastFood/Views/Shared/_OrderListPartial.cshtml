@model IEnumerable<FastFood.Models.Order>
@{
    bool isAdmin = ViewData["IsAdmin"] as bool? ?? false;
}

<div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th>Mã đơn</th>
                <th>Ngày đặt</th>
                <th>Người nhận</th>
                <th>Tổng tiền</th>
                <th>Thanh toán</th>
                <th>Trạng thái</th>
                <th class="text-end">Hành động</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var order in Model)
                {
                    <tr>
                        <td>
                            <strong class="text-primary font-monospace">@order.OrderCode</strong>
                        </td>
                        <td>
                            <small class="text-muted">@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</small>
                        </td>
                        <td>
                            <div><strong>@order.CustomerName</strong></div>
                            <small class="text-muted"><i class="fa fa-phone me-1"></i>@order.Phone</small>
                        </td>
                        <td>
                            <strong class="text-danger">@order.TotalAmount.ToString("N0") đ</strong>
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border">@order.PaymentMethod</span>
                        </td>
                        <td>
                            @switch (order.Status)
                            {
                                case "Đã giao":
                                    <span class="badge bg-success"><i class="fa fa-check me-1"></i>Đã giao</span>
                                    break;
                                case "Đang giao":
                                    <span class="badge bg-info text-dark"><i class="fa fa-motorcycle me-1"></i>Đang giao</span>
                                    break;
                                case "Đã hủy":
                                    <span class="badge bg-danger"><i class="fa fa-times me-1"></i>Đã hủy</span>
                                    break;
                                default:
                                    <span class="badge bg-warning text-dark"><i class="fa fa-clock me-1"></i>@order.Status</span>
                                    break;
                            }
                        </td>
                        <td class="text-end">
                            @if (isAdmin)
                            {
                                <a asp-area="Admin" asp-controller="Order" asp-action="Details" asp-route-id="@order.OrderId" class="btn btn-sm btn-outline-primary">
                                    <i class="fa fa-eye me-1"></i> Xem hóa đơn
                                </a>
                                <a asp-area="Admin" asp-controller="Order" asp-action="Delete" asp-route-id="@order.OrderId" class="btn btn-sm btn-outline-danger ms-1" title="Xóa đơn hàng">
                                    <i class="fa fa-trash"></i> Xóa
                                </a>
                            }
                            else
                            {
                                <a asp-area="" asp-controller="Order" asp-action="Detail" asp-route-id="@order.OrderId" class="btn btn-sm btn-outline-danger">
                                    <i class="fa fa-receipt me-1"></i> Xem hóa đơn
                                </a>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-center py-4 text-muted">
                        <i class="fa fa-inbox fa-2x mb-2 d-block text-secondary"></i>
                        Chưa có đơn hàng nào phát sinh.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
