@model IEnumerable<FastFood.Models.Order>
@{
    Layout = "_MasterLayout";
    ViewData["Title"] = "Lịch Sử Giao Dịch";
}
<div class="container py-4">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-danger text-decoration-none">Trang Chủ</a></li>
            <li class="breadcrumb-item active" aria-current="page">Lịch Sử Giao Dịch</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-extrabold text-dark mb-1"><i class="fa fa-history text-danger me-2"></i>Lịch Sử Giao Dịch Đơn Hàng</h2>
            <p class="text-muted small mb-0">Theo dõi tiến độ và xem lại hóa đơn các đơn hàng bạn đã đặt</p>
        </div>
        <span class="badge bg-danger fs-6 px-3 py-2">@Model.Count() đơn hàng</span>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
        <div class="card-body p-0">
            @await Html.PartialAsync("_OrderListPartial", Model, new ViewDataDictionary(ViewData) { { "IsAdmin", false } })
        </div>
    </div>
</div>
