@model FastFood.Models.ViewModels.ProductFilterViewModel
@{
    Layout = "_MasterLayout";
    ViewData["Title"] = "Thực Đơn Món Ăn";
}

<div class="container py-4">
    <!-- TIÊU ĐỀ & BREADCRUMB -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-danger text-decoration-none">Trang Chủ</a></li>
            <li class="breadcrumb-item active" aria-current="page">Thực Đơn</li>
        </ol>
    </nav>

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="fw-extrabold text-dark mb-1">Thực Đơn FastFood</h2>
            <p class="text-muted small mb-0">Tìm thấy <strong>@Model.TotalItems</strong> món ăn ngon sẵn sàng phục vụ</p>
        </div>
    </div>

    <div class="row g-4">
        <!-- CỘT BỘ LỌC (FILTER SIDEBAR) -->
        <div class="col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white sticky-top" style="top: 90px;">
                <h5 class="fw-bold text-dark mb-3"><i class="fa fa-filter text-danger me-2"></i>Bộ Lọc Món Ăn</h5>

                <form asp-action="Index" method="get">
                    <!-- TÌM KIẾM THEO TỪ KHÓA (BAREM) -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-muted">Từ khóa tìm kiếm:</label>
                        <div class="input-group">
                            <input type="text" name="keyword" class="form-control" placeholder="Tên món ăn..." value="@Model.Keyword" />
                            <button class="btn btn-outline-danger" type="submit"><i class="fa fa-search"></i></button>
                        </div>
                    </div>

                    <!-- LỌC THEO CATEGORY (BAREM) -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-muted">Danh mục món:</label>
                        <select name="categoryId" class="form-select">
                            <option value="">-- Tất cả danh mục --</option>
                            @foreach (var cat in Model.Categories)
                            {
                                <option value="@cat.CategoryId" selected="@(Model.SelectedCategoryId == cat.CategoryId)">
                                    @cat.CategoryName
                                </option>
                            }
                        </select>
                    </div>

                    <!-- LỌC THEO KHOẢNG GIÁ (BAREM) -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-muted">Khoảng giá (VNĐ):</label>
                        <div class="row g-2">
                            <div class="col-6">
                                <input type="number" name="minPrice" class="form-control form-control-sm" placeholder="Từ" value="@Model.MinPrice" />
                            </div>
                            <div class="col-6">
                                <input type="number" name="maxPrice" class="form-control form-control-sm" placeholder="Đến" value="@Model.MaxPrice" />
                            </div>
                        </div>
                    </div>

                    <!-- SẮP XẾP (BAREM) -->
                    <div class="mb-4">
                        <label class="form-label fw-semibold small text-muted">Sắp xếp theo:</label>
                        <select name="sortOrder" class="form-select">
                            <option value="">Mới nhất</option>
                            <option value="popular" selected="@(Model.SortOrder == "popular")">Bán chạy nhất</option>
                            <option value="price_asc" selected="@(Model.SortOrder == "price_asc")">Giá tăng dần</option>
                            <option value="price_desc" selected="@(Model.SortOrder == "price_desc")">Giá giảm dần</option>
                        </select>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-danger fw-bold rounded-pill">
                            <i class="fa fa-check me-1"></i> Áp Dụng Lọc
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill">
                            <i class="fa fa-redo me-1"></i> Xóa Bộ Lọc
                        </a>
                    </div>
                </form>
            </div>
        </div>

        <!-- CỘT DANH SÁCH MÓN ĂN -->
        <div class="col-lg-9">
            @if (Model.Products.Any())
            {
                <div class="row g-4">
                    @foreach (var item in Model.Products)
                    {
                        <div class="col-md-6 col-xl-4">
                            <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden bg-white">
                                <div class="position-relative">
                                    <a asp-action="Detail" asp-route-id="@item.ProductId">
                                        <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "https://images.unsplash.com/photo-1568901346375-23c9450c58cd?w=400&q=80" : item.ImageUrl)" 
                                             class="card-img-top object-fit-cover" height="210" alt="@item.ProductName" />
                                    </a>
                                    <span class="badge bg-warning text-dark position-absolute top-0 end-0 m-3 rounded-pill fw-bold">
                                        @(item.Category?.CategoryName ?? "FastFood")
                                    </span>
                                </div>
                                <div class="card-body p-3 d-flex flex-column justify-content-between">
                                    <div>
                                        <h5 class="fw-bold mb-1">
                                            <a asp-action="Detail" asp-route-id="@item.ProductId" class="text-dark text-decoration-none">
                                                @item.ProductName
                                            </a>
                                        </h5>
                                        <p class="text-muted small text-truncate-2 mb-2">
                                            @(item.Description ?? "Món ngon hấp dẫn nóng hổi.")
                                        </p>
                                    </div>
                                    <div>
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <span class="fs-5 fw-extrabold text-danger">@item.Price.ToString("N0") đ</span>
                                            <span class="badge bg-success-subtle text-success">Còn: @item.Quantity</span>
                                        </div>
                                        <div class="d-grid gap-2">
                                            <!-- MUA HÀNG (BAREM) -->
                                            <form asp-controller="Cart" asp-action="AddToCart" method="post">
                                                <input type="hidden" name="productId" value="@item.ProductId" />
                                                <input type="hidden" name="quantity" value="1" />
                                                <button type="submit" class="btn btn-danger btn-sm w-100 fw-bold">
                                                    <i class="fa fa-cart-plus me-1"></i> Mua Ngay
                                                </button>
                                            </form>
                                            <!-- XEM CHI TIẾT (BAREM) -->
                                            <a asp-action="Detail" asp-route-id="@item.ProductId" class="btn btn-outline-secondary btn-sm">
                                                <i class="fa fa-eye me-1"></i> Chi tiết món
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- PHÂN TRANG KẾT QUẢ TÌM KIẾM (YÊU CẦU BAREM 0.25) -->
                @if (Model.TotalPages > 1)
                {
                    <nav class="mt-5" aria-label="Page navigation">
                        <ul class="pagination justify-content-center">
                            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" 
                                   asp-route-page="@(Model.CurrentPage - 1)" 
                                   asp-route-categoryId="@Model.SelectedCategoryId"
                                   asp-route-keyword="@Model.Keyword"
                                   asp-route-minPrice="@Model.MinPrice"
                                   asp-route-maxPrice="@Model.MaxPrice"
                                   asp-route-sortOrder="@Model.SortOrder">
                                    <i class="fa fa-chevron-left"></i>
                                </a>
                            </li>
                            @for (int p = 1; p <= Model.TotalPages; p++)
                            {
                                <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link @(p == Model.CurrentPage ? "bg-danger border-danger" : "text-dark")" 
                                       asp-action="Index" 
                                       asp-route-page="@p"
                                       asp-route-categoryId="@Model.SelectedCategoryId"
                                       asp-route-keyword="@Model.Keyword"
                                       asp-route-minPrice="@Model.MinPrice"
                                       asp-route-maxPrice="@Model.MaxPrice"
                                       asp-route-sortOrder="@Model.SortOrder">
                                        @p
                                    </a>
                                </li>
                            }
                            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" 
                                   asp-route-page="@(Model.CurrentPage + 1)"
                                   asp-route-categoryId="@Model.SelectedCategoryId"
                                   asp-route-keyword="@Model.Keyword"
                                   asp-route-minPrice="@Model.MinPrice"
                                   asp-route-maxPrice="@Model.MaxPrice"
                                   asp-route-sortOrder="@Model.SortOrder">
                                    <i class="fa fa-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                }
            }
            else
            {
                <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white">
                    <i class="fa fa-search fa-3x text-muted mb-3"></i>
                    <h4 class="fw-bold text-dark">Không tìm thấy món ăn phù hợp!</h4>
                    <p class="text-muted">Vui lòng thử tìm kiếm với từ khóa khác hoặc điều chỉnh lại bộ lọc giá.</p>
                    <div>
                        <a asp-action="Index" class="btn btn-outline-danger px-4 rounded-pill">Xem tất cả món</a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
