@model FastFood.Models.Product
@{
    Layout = "_MasterLayout";
    ViewData["Title"] = Model.ProductName + " - Chi Tiết";
    var relatedProducts = ViewBag.RelatedProducts as List<FastFood.Models.Product> ?? new List<FastFood.Models.Product>();
}

<div class="container py-4">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-danger text-decoration-none">Trang Chủ</a></li>
            <li class="breadcrumb-item"><a asp-controller="Product" asp-action="Index" class="text-danger text-decoration-none">Thực Đơn</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.ProductName</li>
        </ol>
    </nav>

    <!-- TÁI SỬ DỤNG PARTIAL VIEW DETAIL PRODUCT (CÓ NÚT MUA VÀ TRUYỀN SỐ LƯỢNG) -->
    @await Html.PartialAsync("_ProductDetailPartial", Model, new ViewDataDictionary(ViewData) { { "IsCustomer", true } })

    <!-- SẢN PHẨM LIÊN QUAN -->
    @if (relatedProducts.Any())
    {
        <div class="mt-5 pt-4 border-top">
            <h4 class="fw-bold text-dark mb-4"><i class="fa fa-fire text-danger me-2"></i>Có Thể Bạn Cũng Thích</h4>
            <div class="row g-4">
                @foreach (var item in relatedProducts)
                {
                    <div class="col-md-4">
                        <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden bg-white">
                            <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "https://images.unsplash.com/photo-1568901346375-23c9450c58cd?w=400&q=80" : item.ImageUrl)" 
                                 class="card-img-top object-fit-cover" height="180" alt="@item.ProductName" />
                            <div class="card-body p-3 d-flex flex-column justify-content-between">
                                <h6 class="fw-bold mb-1">
                                    <a asp-action="Detail" asp-route-id="@item.ProductId" class="text-dark text-decoration-none">
                                        @item.ProductName
                                    </a>
                                </h6>
                                <div class="d-flex justify-content-between align-items-center mt-2">
                                    <span class="fw-bold text-danger">@item.Price.ToString("N0") đ</span>
                                    <a asp-action="Detail" asp-route-id="@item.ProductId" class="btn btn-sm btn-outline-danger">Xem</a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>
